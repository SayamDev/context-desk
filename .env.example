MODEL_API_KEY=
PORT=3001

# Optional local importer overrides
# YTDLP_PYTHON=python3
# FFMPEG_PATH=/absolute/path/to/ffmpeg

# Optional durable private data directory (default: .context-desk)
# CONTEXT_DESK_DATA_DIR=/absolute/private/path/context-desk

# Optional social account connections. No credentials are shipped.
# Configure approved OAuth clients and exact localhost callback URLs first.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3001/api/social/callback/youtube
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:3001/api/social/callback/tiktok
# TIKTOK_LOGIN_MODE=desktop
# Uploading remains disabled until deliberately enabled; provider review still applies.
# CONTEXT_DESK_SOCIAL_PUBLISHING_ENABLED=1

# Optional local clip discovery. Start VoiceStudio and Ollama and install this model.
# CONTEXT_DESK_LOCAL_STORY_MODEL=llama3.2:latest
