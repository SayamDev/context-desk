  "narrative": {
    "northStar": "The Source-Linked Production Desk",
    "overview": "Quiet charcoal chrome gives real video the brightest, largest working surface. Warm peach marks actions, source links and suggested intervals; editing controls remain compact and readable. Creative decisions stay tied to source time, inspectable evidence and honest gaps.\n\nThe operating sequence is source → discover → review → edit → export. One navigation and a project/save strip orient the working screens. Discover pairs the source monitor with a real time axis and coverage lanes; Studio pairs its viewer with trim work and caption correction. This is an operating application: existing media, edit and queue controllers retain ownership of their controls.\n\nThe user-authorized V2 replaces the former lilac/plum/lime identity. Its visual authority is the selected 12ui B concept and expanded screen family, adapted to the real app. No Impeccable concept seed or roll was run. The direction and comparison evidence are recorded in [V2 visual research](docs/V2-VISUAL-RESEARCH.md).",
    "keyCharacteristics": [
      "Video-led workspaces with restrained charcoal boundaries.",
      "Peach source/action signals and mint acknowledged completion.",
      "Readable functional sans with a locally hosted Manrope wordmark.",
      "Source-derived frames, actual time and visible coverage gaps.",
      "One compact navigation with contextual editing disclosures."
    ],
    "rules": [
      {
        "name": "The Source Signal Rule",
        "body": "Peach connects an action or a source-linked selection to the current task; it is not a substitute for video or evidence.",
        "section": "colors"
      },
      {
        "name": "The Acknowledgement Rule",
        "body": "Mint and rose report actual application state. Color is accompanied by status text, labels or the relevant control state.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Reserve Manrope for the wordmark. Use the functional sans for headings, labels, evidence and editing; do not extend the brand into a decorative display treatment.",
        "section": "typography"
      },
      {
        "name": "The Single Desk Rule",
        "body": "Keep one workspace navigation and one representation of each owned control. Move existing controls to their context rather than cloning them into a second rail or settings surface.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use tonal surfaces and borders for grouping. Reserve shadow-like treatments for readable media overlays and crop masking.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep source video, actual time and the current editorial task prominent.",
      "**Do** use peach for actions and source-linked selections, mint for acknowledged state, and rose for review or errors.",
      "**Do** keep labels, numeric trim alternatives, source context and uncertainty visible or directly reachable.",
      "**Do** use one navigation and retain canonical controls when adapting layouts.",
      "**Do** use source-derived media or an explicit unavailable/empty state.",
      "**Do** preserve native dialog/select behavior, keyboard focus and reduced-motion support."
    ],
    "donts": [
      "**Don't** restore the superseded plum/lilac/lime identity or add gradients, glow, glass, decorative pill eyebrows or oversized italic serif display type.",
      "**Don't** invent avatars, accounts, notifications, statistics, scan percentages, waveforms or fictional footage to fill the interface.",
      "**Don't** turn sampled coverage into a claim that unseen source has been reviewed.",
      "**Don't** use color alone for status or replace editable numeric controls with pointer-only handles.",
      "**Don't** add ambient card shadows or a redundant navigation rail."
    ]
  }
}
